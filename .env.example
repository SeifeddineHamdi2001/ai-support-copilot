# Copy to .env:  cp .env.example .env
# Defaults use mock AI providers: no API key needed.
#
# Two ways to run:
#   - Development (no Docker): native PostgreSQL 16+ with the pgvector extension installed.
#     Uses DATABASE_URL / TEST_DATABASE_URL below.  pnpm db:migrate && pnpm db:seed && pnpm dev
#   - Production-style (Docker): docker compose up --build
#     compose.yaml has the same defaults, so it also works without a .env file. The API container gets
#     its own DATABASE_URL pointing at the `db` service; the two URLs below are ignored there.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development database on your local Postgres. pgvector must be installed on the server; the first
# migration runs CREATE EXTENSION vector, which requires a superuser role (e.g. postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot?schema=public
# Database used by `pnpm test:int` when set. It is DROPPED and recreated on every run, so its name must
# end in "_test". Leave empty to have the integration tests start a throwaway Docker container instead.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot_test?schema=public
# Credentials for the Postgres container in compose.yaml (Docker only).
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the NestJS API listens on. Base URL: http://localhost:3001/api/v1, Swagger: /api/docs
API_PORT=3001
# Comma-separated origins allowed by CORS (the web app).
CORS_ORIGIN=http://localhost:3000
# Run the idempotent seed (agents, customers, tickets) every time the API container starts.
SEED_ON_START=true

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# mock   = deterministic keyword classifier + cited drafts built from retrieved chunks (default, no key)
# gemini = Google Gemini via Vercel AI SDK (requires GEMINI_API_KEY)
LLM_PROVIDER=mock
# mock   = deterministic 768-dim feature-hashing embeddings (default, no key)
# gemini = gemini-embedding-001 at 768 dims. After switching providers run `pnpm kb:reindex`.
EMBEDDING_PROVIDER=mock
# Google AI Studio key. Leave empty with mock providers; the API refuses to boot if gemini is selected without it.
GEMINI_API_KEY=
# Generation model used when LLM_PROVIDER=gemini.
LLM_MODEL=gemini-2.5-flash-lite
# Embedding model used when EMBEDDING_PROVIDER=gemini (output dimensionality fixed at 768).
EMBEDDING_MODEL=gemini-embedding-001
# Per-call timeout for LLM requests, in milliseconds.
LLM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Retrieval (RAG)
# ---------------------------------------------------------------------------
# Minimum cosine similarity a retrieved chunk needs to be used for a draft (0..1).
# Leave empty to use the provider default: 0.55 for gemini, 0.15 for the mock hash embedder.
RAG_MIN_SIMILARITY=
# Number of chunks kept after hybrid search + Reciprocal Rank Fusion.
RAG_TOP_K=5

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# API base URL as seen from the browser. Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Published host ports for the web and api containers.
WEB_PORT=3000
